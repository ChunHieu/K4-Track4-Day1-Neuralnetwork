   "source": [
    "# TODO 4: Quá khớp 20 mẫu → loss về gần 0\n",
    "set_seed(0)\n",
    "model_overfit = MLP(hidden=(256, 128), dropout=0.0, init=\"he\").to(device)\n",
    "opt_of = torch.optim.SGD(model_overfit.parameters(), lr=0.1, momentum=0.9)\n",
    "X_tiny, y_tiny = X_tr[:20], y_tr[:20]\n",
    "\n",
    "losses_of = []\n",
    "model_overfit.train()\n",
    "for step in range(300):\n",
    "    logits_of = model_overfit(X_tiny)\n",
    "    loss_of   = torch.nn.functional.cross_entropy(logits_of, y_tiny)\n",
    "    opt_of.zero_grad(set_to_none=True)\n",
    "    loss_of.backward()\n",
    "    opt_of.step()\n",
    "    losses_of.append(loss_of.item())\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "fig, ax = plt.subplots(figsize=(7, 3))\n",
    "ax.plot(losses_of)\n",
    "ax.set_xlabel(\"Step\"); ax.set_ylabel(\"Train Loss (20 mẫu)\")\n",
    "ax.set_title(\"Kiểm tra quá khớp 20 mẫu: loss phải về gần 0\")\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"{OUT_DIR}/figures/overfit_check.png\", dpi=100)\n",
    "plt.show()\n",
    "print(f\"Loss cuối = {losses_of[-1]:.6f}  (kỳ vọng < 0.01)\")"
