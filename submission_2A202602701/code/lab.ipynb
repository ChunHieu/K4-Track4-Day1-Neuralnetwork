  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "opt_results = []\n",
    "cfg_base_fixed = {**DEFAULT_CFG, \"lr\": best_lr, \"seed\": 1, \"group\": \"optimizer\"}\n",
    "\n",
    "for opt_name, lr_opt in [(\"sgd_momentum\", best_lr), (\"adam\", 1e-3), (\"adamw\", 1e-3)]:\n",
