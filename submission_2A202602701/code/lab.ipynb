    "print(f\"  mean ≈ {x_num.mean(axis=0).round(4)}\")\n",
    "print(f\"  std  ≈ {x_num.std(axis=0).round(4)}\")\n",
    "\n",
    "print()\n",
    "majority = int(torch.bincount(y_tr).argmax())\n",
    "maj_acc  = float((y_val == majority).float().mean())\n",
    "print(f\"=== Chiến lược đoán lớp đa số ({majority}) trên val ===\")\n",
    "print(f\"  Accuracy = {maj_acc:.4f}  (mốc ≈ 0.4876)\")\n",
    "\n",
    "print()\n",
    "print(f\"=== eval_row_id: shape={eval_row_id.shape}, 5 đầu={eval_row_id[:5]} ===\")"
   ]
