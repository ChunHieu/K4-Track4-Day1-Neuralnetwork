    "Chia sẵn bằng metadata → chạy `scripts/split_data.py` (tạo `data/processed/train.npz`, `eval.npz`).\n",
    "Sau đó tách validation (20%, seed=42, phân tầng), chuẩn hoá bằng thống kê train, đưa lên device."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Bước 0a: Tạo train.npz và eval.npz\n",
    "res = subprocess.run(\n",
    "    [sys.executable, \"scripts/split_data.py\"],\n",
    "    cwd=REPO_ROOT, capture_output=True,\n",
    "    text=True, encoding=\"utf-8\", errors=\"replace\"\n",
    ")\n",
    "print(res.stdout)\n",
    "if res.returncode != 0:\n",
    "    print(\"STDERR:\", res.stderr)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Bước 0b: Tách val, chuẩn hoá, đưa lên device\n",
    "# val_fraction=0.2, seed=42 — CỐ ĐỊNH cho mọi thí nghiệm\n",
    "data = prepare_data(\n",
    "    device, val_fraction=0.2, seed=42,\n",
    "    processed_dir=f\"{REPO_ROOT}/data/processed\"\n",
    ")\n",
    "X_tr,  y_tr  = data[\"X_tr\"],  data[\"y_tr\"]\n",
    "X_val, y_val = data[\"X_val\"], data[\"y_val\"]\n",
    "X_eval, y_eval = data[\"X_eval\"], data[\"y_eval\"]\n",
    "eval_row_id  = data[\"eval_row_id\"]"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Bước 0c: Kiểm tra shape, dtype, chuẩn hoá và mốc accuracy\n",
    "print(\"=== Shape & dtype ===\")\n",
    "for name, X, y in [(\"train\", X_tr, y_tr), (\"val\", X_val, y_val), (\"eval\", X_eval, y_eval)]:\n",
    "    print(f\"  {name:5s}: X {tuple(X.shape)} {X.dtype} | y {tuple(y.shape)} {y.dtype} | label [{int(y.min())},{int(y.max())}]\")\n",
    "\n",
    "print()\n",
    "print(\"=== Chuẩn hoá (10 cột số, X_tr) ===\")\n",
