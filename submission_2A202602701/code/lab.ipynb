    "    plot_run(result, f\"{OUT_DIR}/figures/opt-{opt_name}.png\")\n",
    "\n",
    "plot_compare(opt_results, \"val_macro_f1\", f\"{OUT_DIR}/figures/compare_optimizer.png\",\n",
